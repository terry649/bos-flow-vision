# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets
.env
.env.*
!.env.example

# Data: synthetic data is regenerated from seeds; real data never enters git
data/synthetic/*
!data/synthetic/.gitkeep
data/real/*
!data/real/README.md
!data/real/CLEARED.md

# Model weights and large artifacts
*.pt
*.pth
*.onnx
runs/
results/**/*.npz

.DS_Store
results/ci_benchmark/
runs/
# M4 videos: keep one typical and one failure case per model
results/m4/*/blast_*.mp4
!results/m4/*/blast_003.mp4
!results/m4/*/blast_014.mp4

# NASA reference images are fetched by scripts/fetch_nasa_airbos.py, not committed
data/public/*/*.jpg
data/public/*/*.tif

# NASA reference images are fetched by scripts/fetch_nasa_airbos.py, not committed
data/public/*/*.jpg
data/public/*/*.tif
# M4 evaluation outputs: keep metrics, tracks, and three illustrative videos
results/m4_experiments/eval*/**/predictions_*.json
results/m4_experiments/eval*/**/*.mp4
results/m4_experiments/eval*/results.json
!results/m4_experiments/eval_p3/arm_B_v2_data/sequences/blast_014.mp4
!results/m4_experiments/eval_d3/arm_D_platform_labels/sequences/blast_014.mp4
!results/m4_experiments/eval/v2_hosted/sequences/blast_014.mp4
results/m4_experiments/**/.synced
